<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>aPFA</string>
	<key>CFBundleExecutable</key>
	<string>aPFA</string>
	<key>CFBundleIdentifier</key>
	<string>com.apfa.ios</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>aPFA</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.3.2</string>
	<key>CFBundleVersion</key>
	<string>18</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>12.0</string>

	<!-- Sideloaded, so the Files app IS the file manager: both keys together
	     put an "aPFA" folder under On My iPhone that MIDIs and soundfonts can
	     be dropped straight into, and expose the same folder over USB in
	     Finder. This is the practical twin of Android's shared storage, and
	     the reason the setup screen's document picker is a convenience rather
	     than the only way in. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Playback owns the whole screen. Without this, iPad Slide Over and
	     Split View can resize the drawable mid-run, which would change the
	     pixel count the renderer is being measured at partway through a piece. -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>opengles-2</string>
	</array>

	<!-- LANDSCAPE ONLY, both ways up. This is the exact equivalent of
	     AndroidManifest.xml's android:screenOrientation="sensorLandscape",
	     which BOTH aPFA activities declare. The note field is a wide
	     playfield with the keyboard along the bottom edge — portrait is not
	     a supported way to look at it, on either platform. Listing Portrait
	     here (and first) is what made the app launch upright on an iPhone SE.

	     Note that a per-view-controller supportedInterfaceOrientations
	     override does NOT work here: UINavigationController does not forward
	     that call to its children. This list is the whole policy. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Only for the optional background-image picker. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick an image to use as the playback background.</string>
</dict>
</plist>
